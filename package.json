{
  "name": "star-admin-free-angular",
  "version": "3.0.0",
  "scripts": {
    "ng": "ng",
    "start": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --no-deprecation\" ng serve",
    "build": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --no-deprecation\" ng build",
    "test": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --no-deprecation\" ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "start:mobile": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --no-deprecation\" ng serve --host 0.0.0.0 --port 4200",
