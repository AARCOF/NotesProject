<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_bg"
    android:orientation="horizontal"
    android:paddingVertical="7dp"
    android:paddingHorizontal="9dp"
    android:gravity="center_vertical">

    <!-- Priority dot indicator -->
    <ImageView
        android:id="@+id/widget_item_priority_indicator"
        android:layout_width="8.5dp"
        android:layout_height="8.5dp"
        android:background="@drawable/widget_priority_circle_low"
        android:layout_marginRight="8dp"
        android:contentDescription="Prioridad" />

    <!-- Task Title (Pure White for transparent glass readability) -->
    <TextView
        android:id="@+id/widget_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Título de la tarea"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
