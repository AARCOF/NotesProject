<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="📝 NoteYou: Pendientes"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/stat_notify_sync"
            android:tint="#38bdf8"
            android:contentDescription="Sincronizar"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Divider Line -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e293b" />

    <!-- List View -->
    <ListView
        android:id="@+id/widget_tasks_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#1e293b"
        android:dividerHeight="0.5dp"
        android:layout_marginTop="4dp"
        android:nestedScrollingEnabled="true" />

    <!-- Empty State View -->
    <TextView
        android:id="@+id/widget_tasks_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="¡Estás al día! No hay tareas."
        android:textColor="#64748b"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
