<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: Base de Cristal Blanco Translúcido Esmerilado -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E0FFFFFF"
                android:centerColor="#D4F8FAFC"
                android:endColor="#E0F1F5F9"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Capa 2: Esfera Líquida Orb Azul / Cian NoteYou (Top-Left) -->
    <item android:left="-35dp" android:top="-35dp" android:right="95dp" android:bottom="95dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#4D38BDF8"
                android:centerColor="#260284C7"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 3: Esfera Líquida Orb Púrpura / Índigo NoteYou (Bottom-Right) -->
    <item android:left="95dp" android:top="85dp" android:right="-35dp" android:bottom="-35dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#40A855F7"
                android:centerColor="#268B5CF6"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 4: Burbuja de Acento Esmeralda / Turquesa -->
    <item android:left="40dp" android:top="75dp" android:right="130dp" android:bottom="15dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="35dp"
                android:startColor="#3310B981"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 5: Placa de Cristal Blanco Translúcido con Borde Especular Crystalline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4DFFFFFF" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1.5dp"
                android:color="#E6FFFFFF" />
        </shape>
    </item>
</layer-list>
