<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: Fondo Base de Cristal Escarchado Oscuro -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#F00F172A"
                android:centerColor="#E61E1B4B"
                android:endColor="#F50B0F19"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Capa 2: Esfera Líquida Orb Azul/Cian (Top-Left) -->
    <item android:left="-30dp" android:top="-30dp" android:right="90dp" android:bottom="90dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#660284C7"
                android:centerColor="#2638BDF8"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 3: Esfera Líquida Orb Púrpura/Rosa (Bottom-Right) -->
    <item android:left="90dp" android:top="80dp" android:right="-30dp" android:bottom="-30dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#59A855F7"
                android:centerColor="#26EC4899"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 4: Pequeña Burbuja Flotante Esmeralda (Acento Liquid Glass) -->
    <item android:left="30dp" android:top="70dp" android:right="140dp" android:bottom="20dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="35dp"
                android:startColor="#4010B981"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 5: Placa Superior de Cristal Líquido con Borde Especular -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1.5dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
