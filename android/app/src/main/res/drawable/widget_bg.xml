<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: Base de Cristal Ultratranslúcido Liquid Glass (Transparente) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#331E293B"
                android:centerColor="#260F172A"
                android:endColor="#331E293B"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Capa 2: Esfera Líquida Orb Azul / Cian NoteYou (Top-Left) -->
    <item android:left="-35dp" android:top="-35dp" android:right="95dp" android:bottom="95dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:startColor="#4D38BDF8"
                android:centerColor="#260284C7"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 3: Esfera Líquida Orb Púrpura / Índigo NoteYou (Bottom-Right) -->
    <item android:left="95dp" android:top="85dp" android:right="-35dp" android:bottom="-35dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:startColor="#40A855F7"
                android:centerColor="#268B5CF6"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 4: Burbuja Líquida Esmeralda NoteYou (Accent) -->
    <item android:left="35dp" android:top="70dp" android:right="125dp" android:bottom="20dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:startColor="#3334D399"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Capa 5: Placa Crystalline con Borde Especular y Reflejo de Cristal Translúcido -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1.5dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
