<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#F00284C7"
                android:centerColor="#F00369A1"
                android:endColor="#F04338CA"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1.2dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
